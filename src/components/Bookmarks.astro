---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  type Bookmark = { url: string; slug: string };
  const KEY = 'mona-bookmarks';
  const ALPHABET = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';

  const form = document.getElementById('add-bookmark') as HTMLFormElement;
  const input = document.getElementById('url') as HTMLInputElement;
  const list = document.getElementById('bookmark-list') as HTMLUListElement;
  const empty = document.getElementById('empty-state') as HTMLElement;
  const header = document.getElementById('list-header') as HTMLElement;
  const clearAll = document.getElementById('clear-all') as HTMLButtonElement;

  function load(): Bookmark[] {
    try {
      const data = JSON.parse(localStorage.getItem(KEY) ?? '[]');
      return Array.isArray(data)
        ? data.filter((b) => b && typeof b.url === 'string' && typeof b.slug === 'string')
        : [];
    } catch {
      return [];
    }
  }

  function save(items: Bookmark[]) {
    try {
      localStorage.setItem(KEY, JSON.stringify(items));
    } catch {
      /* storage unavailable or full */
    }
  }

  function normalizeUrl(raw: string): string | null {
    const text = raw.trim();
    if (!text) return null;
    const candidate = /^[a-z][a-z0-9+.-]*:\/\//i.test(text) ? text : `https://${text}`;
    try {
      const u = new URL(candidate);
      return u.protocol === 'http:' || u.protocol === 'https:' ? u.href : null;
    } catch {
      return null;
    }
  }

  function generateSlug(taken: Set<string>): string {
    for (;;) {
      const bytes = crypto.getRandomValues(new Uint8Array(4));
      const slug = 'mona-' + Array.from(bytes, (b) => ALPHABET[b % ALPHABET.length]).join('');
      if (!taken.has(slug)) return slug;
    }
  }

  let bookmarks = load();

  function render() {
    list.replaceChildren();
    for (const b of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';
      const a = document.createElement('a');
      a.className = 'url';
      a.href = b.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = b.url;
      const badge = document.createElement('span');
      badge.className = 'slug';
      badge.textContent = b.slug;
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.slug);
          copy.textContent = 'Copied!';
        } catch {
          copy.textContent = 'Copy failed';
        }
        setTimeout(() => (copy.textContent = 'Copy'), 1500);
      });
      li.append(a, badge, copy);
      list.append(li);
    }
    empty.hidden = bookmarks.length > 0;
    header.hidden = bookmarks.length === 0;
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this — stops the page from reloading
    const url = normalizeUrl(input.value);
    if (!url) {
      input.setCustomValidity('Enter a valid http(s) URL.');
      input.reportValidity();
      return;
    }
    input.setCustomValidity('');
    const slug = generateSlug(new Set(bookmarks.map((b) => b.slug)));
    bookmarks = [{ url, slug }, ...bookmarks];
    save(bookmarks);
    render();
    form.reset();
    input.focus();
  });

  input.addEventListener('input', () => input.setCustomValidity(''));

  clearAll.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(KEY);
    } catch {
      /* ignore */
    }
    render();
  });

  render();
</script>
