<form id="add-bookmark" onsubmit="event.preventDefault()">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      aria-describedby="bookmark-hint bookmark-status"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="bookmark-hint" class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>
<p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<script>
  import { BOOKMARK_SEPARATOR, generateSlug, normalizeUrl, parseBookmarks, STORAGE_KEY, type Bookmark } from '../lib/bookmarks';

  const form = document.querySelector<HTMLFormElement>('#add-bookmark')!;
  const input = document.querySelector<HTMLInputElement>('#url')!;
  const status = document.querySelector<HTMLElement>('#bookmark-status')!;
  const empty = document.querySelector<HTMLElement>('#empty-state')!;
  const header = document.querySelector<HTMLElement>('#list-header')!;
  const list = document.querySelector<HTMLUListElement>('#bookmark-list')!;
  const clear = document.querySelector<HTMLButtonElement>('#clear-all')!;
  let bookmarks: Bookmark[] = [];

  function withStorageLock<T>(callback: () => T | Promise<T>): Promise<T> {
    if (!navigator.locks) {
      return Promise.reject(new Error('This browser cannot safely synchronize bookmarks across tabs.'));
    }
    return navigator.locks.request(STORAGE_KEY, callback);
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const url = input.value;
    void withStorageLock(() => {
      const current = parseBookmarks(localStorage.getItem(STORAGE_KEY));
      const bookmark = { url: normalizeUrl(url), slug: generateSlug(current) };
      const updated = [...current, bookmark];
      localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
      bookmarks = updated;
      render();
      input.value = '';
      status.textContent = 'Bookmark saved.';
      input.focus();
    }).catch((error: unknown) => {
      status.textContent = error instanceof Error && error.message.startsWith('Enter ')
        ? error.message
        : error instanceof Error && error.message.startsWith('This browser')
          ? error.message
          : 'Could not save your bookmark. Check that browser storage is available and try again.';
    });
  });

  function render() {
    list.replaceChildren();
    empty.hidden = bookmarks.length > 0;
    header.hidden = bookmarks.length === 0;
    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';
      const text = document.createElement('span');
      text.className = 'bookmark-text';
      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      text.append(link, document.createTextNode(BOOKMARK_SEPARATOR), slug);
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          status.textContent = `Copied ${bookmark.slug}.`;
        } catch {
          status.textContent = 'Could not copy the slug. Select it and copy it manually.';
        }
      });
      row.append(text, copy);
      list.append(row);
    }
  }

  clear.addEventListener('click', () => {
    if (!confirm('Clear all saved bookmarks?')) return;
    void withStorageLock(() => {
      localStorage.removeItem(STORAGE_KEY);
      bookmarks = [];
      render();
      status.textContent = 'Bookmarks cleared.';
    }).catch(() => {
      status.textContent = 'Could not clear bookmarks. Check that browser storage is available and try again.';
    });
  });

  window.addEventListener('storage', (event) => {
    if (event.key !== STORAGE_KEY && event.key !== null) return;
    bookmarks = parseBookmarks(event.key === null ? null : event.newValue);
    render();
  });

  try {
    bookmarks = parseBookmarks(localStorage.getItem(STORAGE_KEY));
  } catch {
    status.textContent = 'Could not load bookmarks. Check that browser storage is available.';
  }
  render();
</script>
